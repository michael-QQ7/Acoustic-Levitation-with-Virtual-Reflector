+    private double evalLaplacianAxis(int axis) {
+        Vector2f[] first=firstFields(); Vector2f[][] second=secondFields(),third=thirdFields();
+        double v=K1*(first[axis].dot(first[axis])+pre.dot(second[axis][axis]));
